{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verdict"],
  "properties": {
    "verdict": { "enum": ["approved", "revise"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note"],
        "properties": {
          "section": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
